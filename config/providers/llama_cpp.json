{
  "provider_name": "llama_cpp",
  "endpoint": "http://127.0.0.1:8080/v1",
  "auth_type": "none",
  "enabled": true,
  "priority": 100,
  "default_model": "qwen2.5-coder-7b-instruct-q4_k_m",
  "timeout_seconds": 120,
  "retry_count": 1,
  "supports_streaming": true,
  "supports_tool_calling": true,
  "supports_vision": false,
  "supports_function_calling": true,
  "options": {
    "model_directory": "D:\\llama_models",
    "server_executable": "D:\\llama_cpp_cuda\\llama-server.exe",
    "port": 8080,
    "startup_timeout_seconds": 180,
    "stop_owned_server_on_exit": true,
    "context_size": 8192,
    "threads": 20,
    "threads_batch": 20,
    "gpu_layers": "auto",
    "device": "CUDA0",
    "fit": "on",
    "fit_target_mib": 256,
    "flash_attention": "on",
    "batch_size": 2048,
    "ubatch_size": 512,
    "jinja": true,
    "cache_reuse": 256,
    "slot_save_path": "temp/kv_slots"
  }
}
